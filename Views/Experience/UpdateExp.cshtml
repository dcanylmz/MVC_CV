@model MVC_CV.Models.Entity.tbl_Experience
@{
    ViewBag.Title = "UpdateExp";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<!DOCTYPE html>
<html>
<body class="hold-transition sidebar-mini">
    <div class="wrapper">
        <!-- Navbar -->
        <!-- Main content -->
        <section class="content">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header">
                                <h2>Update Experience</h2>
                            </div>
                            <!-- /.card-header -->
                            <div class="card-body">
                                <form class="form-group" method="post">
                                    @Html.Label("Exp ID")
                                    @Html.TextBoxFor(x => x.ID, new { @class = "form-control" })
                                    <br />
                                    @Html.Label("Exp Title")
                                    @Html.TextBoxFor(x => x.Title, new { @class = "form-control" })
                                    <br />
                                    @Html.Label("Exp Subtitle")
                                    @Html.TextBoxFor(x => x.Subtitle, new { @class = "form-control" })
                                    <br />
                                    @Html.Label("Exp Date")
                                    @Html.TextBoxFor(x => x.Date, new { @class = "form-control" })
                                    <br />
                                    @Html.Label("Exp Subtitle")
                                    @Html.TextAreaFor(x => x.Description, new { @class = "form-control", rows = "7" })
                                    <br />
                                    <button class="btn btn-info">Save</button>
                                </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </body>
</html>
