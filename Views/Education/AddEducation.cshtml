@model MVC_CV.Models.Entity.tbl_Education
@{
    ViewBag.Title = "AddEducation";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<!DOCTYPE html>
<html>
<body class="hold-transition sidebar-mini">
    <div class="wrapper">
        <!-- Navbar -->
        <!-- Main content -->
        <section class="content">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header">
                                <h2>Add New Education</h2>
                            </div>
                            <!-- /.card-header -->
                            <div class="card-body">

                                <form class="form-group" method="post">
                                    @Html.Label("Department")
                                    @Html.TextBoxFor(x => x.Title, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(x=>x.Title, "", new { @style = "color:red;" })
                                    <br />
                                    @Html.Label("Title")
                                    @Html.TextBoxFor(x => x.Subtitle1, new { @class = "form-control" })
                                    <br />
                                    @Html.Label("Date")
                                    @Html.TextBoxFor(x => x.Date, new { @class = "form-control" })
                                    <br />

                                    <button class="btn btn-info">Save</button>
                                </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </body>
</html>

