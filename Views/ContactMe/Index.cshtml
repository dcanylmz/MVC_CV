@using MVC_CV.Models.Entity
@model List<tbl_Contact>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@{
    string renk = "";
}
<!DOCTYPE html>
<html>
<body class="hold-transition sidebar-mini">
    <div class="wrapper">
        <!-- Navbar -->
        <!-- Main content -->
        <section class="content">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header">
                                <h2>Contact List</h2>
                            </div>
                            <!-- /.card-header -->
                            <div class="card-body">

                                <div class="tab-content">

                                    <div class="tab-panel" id="timeline">
                                        <!-- The timeline -->
                                        @foreach (var item in Model)
                                        {
                                            <div class="timeline timeline-inverse">
                                                <!-- timeline time label -->



                                                <div class="time-label">
                                                    <span class="bg-gradient-olive">
                                                        @(((DateTime)item.Date).ToString("dd-MMM-yyyy"))
                                                    </span>
                                                </div>
                                                <!-- /.timeline-label -->
                                                <!-- timeline item -->
                                                <div>
                                                    <div class="timeline-item">
                                                        <span class="time"><i class="far fa-clock"></i>@item.Mail</span>
                                                        <h2 class="timeline-header">
                                                            <a href="#">@item.NameSurname</a>
                                                            <br />
                                                            <span>@item.Subject</span>
                                                        </h2>
                                                        <div class="timeline-body">
                                                            @item.Message
                                                        </div>
                                                        <div class="timeline-footer">
                                                            <a href="/ContactMe/UpdateContactMe/@item.ID" class="btn btn-primary btn-sm">Update</a>
                                                            <a href="/ContactMe/DeleteContactMe/@item.ID" class="btn btn-danger btn-sm">Delete</a>
                                                        </div>
                                                    </div>
                                                </div>


                                            </div>
                                        }
                                    </div>

                                </div>
                                <!-- /.tab-content -->
                            </div><!-- /.card-body -->

                        </div>
                        <!-- /.card -->
                    </div>
                </div>
            </div><!-- /.container-fluid -->
        </section>
        <!-- /.content -->
    </div>
</body>
</html>

