@using MVC_CV.Models.Entity
@model List<tbl_About>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<!DOCTYPE html>
<html>
<body class="hold-transition sidebar-mini">
    <div class="wrapper">
        <!-- Navbar -->
        <!-- Main content -->
        <section class="content">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header">
                                <h2>About</h2>
                            </div>
                            <!-- /.card-header -->
                            <div class="card-body">
                                
                                <table class="table table-bordered">
                                    <form method="post">
                                        @foreach (var item in Model)
                                        {
                                            <label>Name</label>
                                            <input type="text" name="Name" value="@item.Name" class="form-control" />
                                            <label>Surname</label>
                                            <input type="text" name="Surname" value="@item.Surname" class="form-control" />
                                            <label>Adress</label>
                                            <input type="text" name="Adress" value="@item.Adress" class="form-control" />
                                            <label>Phone</label>
                                            <input type="text" name="Phone" value="@item.Phone" class="form-control" />
                                            <label>Mail</label>
                                            <input type="text" name="Mail" value="@item.Mail" class="form-control" />
                                            <label>Description</label>
                                            <textarea name="Description" class="form-control" rows="6">@item.Description</textarea>
                                            <label>Photo</label>
                                            <input type="text" name="Photo" value="@item.Photo" class="form-control" />
                                            <br />
                                            <button class="btn btn-success">Save</button>

                                        }
                                    </form>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</body>
</html>