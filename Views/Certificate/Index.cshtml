@using MVC_CV.Models.Entity
@model List<tbl_Certificates>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@{
    string renk = "";
}
<!DOCTYPE html>
<html>
<body class="hold-transition sidebar-mini">
    <div class="wrapper">
        <!-- Navbar -->
        <!-- Main content -->
        <section class="content">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header">
                                <h2>Certificate List</h2>
                            </div>
                            <!-- /.card-header -->
                            <div class="card-body">
                                <a href="/Certificate/AddCertificate/" class="btn btn-primary">Add New Certificate</a>
                                <br />
                                <br />
                                <div class="tab-content">
                                    <div class="tab-panel" id="timeline">
                                        <!-- The timeline -->
                                        @foreach (var item in Model)
                                        {
                                            <div class="timeline timeline-inverse">
                                                <!-- timeline time label -->



                                                <div class="time-label">
                                                    <span class="bg-gradient-olive">
                                                        @item.Date
                                                    </span>
                                                </div>
                                                <!-- /.timeline-label -->
                                                <!-- timeline item -->
                                                <div>
                                                    <div class="timeline-item">
                                                        <div class="timeline-body">
                                                            @item.Description
                                                        </div>
                                                        <div class="timeline-footer">
                                                            <a href="/Certificate/UpdateCertificate/@item.ID" class="btn btn-primary btn-sm">Update</a>
                                                            <a href="/Certificate/DeleteCertificate/@item.ID" class="btn btn-danger btn-sm">Delete</a>
                                                        </div>
                                                    </div>
                                                </div>


                                            </div>
                                        }
                                    </div>
                                </div>
                                <!-- /.tab-content -->
                            </div><!-- /.card-body -->

                        </div>
                        <!-- /.card -->
                    </div>
                </div>
            </div><!-- /.container-fluid -->
        </section>
        <!-- /.content -->
    </div>
</body>
</html>

