@using MVC_CV.Models.Entity
@model List<tbl_Languages>

<div class="resume-section-content">
    <h2 class="mb-5">Languages</h2>
    @foreach (var x in Model)
    {
        <ul class="fa-ul mb-0">
            <li>
                <span class="fa-li"><i class="fas fa-check"></i></span>
                @x.Desc1
            </li>

        </ul>
    }
</div>
